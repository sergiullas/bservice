{
  "name": "app",
  "version": "0.0.1",
  "private": true,
  "bundled": true,
  "description": "STORY 2.3 experimental Backstage harness frontend -- see docs/backstage-compatibility.md. Installs only the servicelog plugin as a feature; Backstage's own new-frontend-system app shell (nav, sign-in, theme) surrounds it. No catalog/search/techdocs/scaffolder.",
  "backstage": {
    "role": "frontend"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/cli": "^0.36.5",
    "@backstage/frontend-defaults": "^0.5.5",
    "@internal/plugin-servicelog": "0.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "files": ["dist"]
