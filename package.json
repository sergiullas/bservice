{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "src/app",
    "metadata",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "prebuild": "npm run validate:metadata",
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "validate:metadata": "tsx scripts/validate-metadata.ts",
    "backstage:tsc": "tsc -p tsconfig.json",
    "build:backstage": "npm run build --workspace=@servicelog/core && npm run build --workspace=@servicelog/metadata && npm run build:css --workspace=@internal/plugin-servicelog && npm run backstage:tsc && npm run build --workspace=@internal/plugin-servicelog-backend && npm run build --workspace=@internal/plugin-servicelog"
  },
  "dependencies": {
    "@material-ui/core": "4.12.4",
    "@material-ui/icons": "4.11.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@backstage/cli-defaults": "^0.1.5",
    "@tailwindcss/vite": "4.1.12",
    "@typescript/typescript6": "^6.0.2",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^27.1.0",
    "tailwindcss": "4.1.12",
    "tsx": "^4.19.2",
    "vite": "6.3.5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "jsdom": "^27.1.0"
  }
}
