# @material-ui/core v4 (unmaintained since 2021, kept intentionally for the
# standalone demo shell's Sidebar -- see STORY 2.3 section 7) declares a
# peer dependency of react "^16.8.0 || ^17.0.0" that was never updated for
# React 18, even though its actual runtime code (ThemeProvider, CssBaseline,
# makeStyles, Box) works fine there. Without this, npm install hard-fails
# on that stale peer range now that the workspace is on React 18 (see
# docs/backstage-compatibility.md section 3 for why). This does not disable
# peer checking selectively -- it is npm's standard escape hatch for
# exactly this "old package, stale peer range, real code still works"
# situation.
legacy-peer-deps=true
